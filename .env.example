# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Your own TypeSafe API key, from https://console.typesafe.ai/keys (the only official source).
TYPESAFE_API_KEY=

# What answers the checks. Leave unset for Jev. Alternatives, none needing a TypeSafe key:
#   local                  offline transformer models  (pip install "jev-guard[local]")
#   cloudflare             Jev via Cloudflare Workers AI (CLOUDFLARE_ACCOUNT_ID + _API_TOKEN)
#   ollama:llama3.1        any OpenAI-compatible server
#   jev,local              try Jev, fall back to local
JEV_GUARD_BACKEND=

# Builtin policy name or YAML path used when Guard() is called without a policy.
JEV_GUARD_DEFAULT_POLICY=general

# Set to 1 to emit OpenTelemetry spans (requires `pip install jev-guard[otel]`).
JEV_GUARD_TELEMETRY_ENABLED=0

# Integration tests only: live Jev calls are skipped unless this is 1, even with a key set.
JEV_GUARD_ALLOW_LIVE=0
